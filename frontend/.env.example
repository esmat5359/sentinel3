# Addresses of your deployed contracts on Studio Devnet (chain id 61997).
# Both are required for live mode; with either unset the app starts in a
# clearly-labelled simulated demo mode instead.
NEXT_PUBLIC_SENTINEL_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=

# Optional: force the simulated demo mode even when both addresses are set.
NEXT_PUBLIC_DEMO_MODE=false
